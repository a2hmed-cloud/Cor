rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 500 && url.matches('^https://.*');
    }

    function isValidStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is string);
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserPrivate(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.preferredLanguage in ['ar', 'en'] &&
             data.themeMode in ['system', 'dark', 'light'] &&
             data.aiModel is string && data.aiModel.size() >= 3 && data.aiModel.size() <= 64 &&
             data.accountStatus in ['active', 'suspended'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 60)) &&
             data.publicProfile is bool &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.postsCount is int && data.postsCount >= 0 &&
             data.resourcesCount is int && data.resourcesCount >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCreativeTool(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 600 &&
             data.descriptionAr is string && data.descriptionAr.size() >= 5 && data.descriptionAr.size() <= 600 &&
             isValidStringList(data.categories, 10) &&
             isValidUrl(data.officialUrl) &&
             data.pricing in ['free', 'freemium', 'paid', 'open_source'] &&
             isValidStringList(data.platforms, 10) &&
             data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5 &&
             data.ratingCount is int && data.ratingCount >= 0 &&
             data.savesCount is int && data.savesCount >= 0 &&
             data.verified is bool &&
             data.lastVerifiedDate is string && data.lastVerifiedDate.size() <= 32 &&
             (!('accentHex' in data) || (data.accentHex is string && data.accentHex.size() <= 16)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCreativeResource(data) {
      return data.creatorId is string && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.titleAr is string && data.titleAr.size() >= 2 && data.titleAr.size() <= 120 &&
             data.description is string && data.description.size() >= 4 && data.description.size() <= 1000 &&
             data.descriptionAr is string && data.descriptionAr.size() >= 4 && data.descriptionAr.size() <= 1000 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             isValidStringList(data.tags, 10) &&
             (!('previewImageUrl' in data) || (data.previewImageUrl is string && data.previewImageUrl.size() <= 500)) &&
             data.fileFormat is string && data.fileFormat.size() >= 1 && data.fileFormat.size() <= 30 &&
             data.fileSizeLabel is string && data.fileSizeLabel.size() >= 1 && data.fileSizeLabel.size() <= 30 &&
             data.licenseInfo is string && data.licenseInfo.size() >= 2 && data.licenseInfo.size() <= 120 &&
             isValidUrl(data.downloadUrl) &&
             !data.downloadUrl.matches('.*\\.(exe|bat|cmd|msi|apk|dex|jar|sh|ps1)(\\?.*)?$') &&
             data.savesCount is int && data.savesCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.moderationStatus in ['pending', 'approved', 'rejected'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCommunityPost(data) {
      return data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             (!('authorAvatarUrl' in data) || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500)) &&
             data.postType in ['image', 'video', 'resource', 'font_discovery', 'design_showcase', 'editing_tutorial', 'creative_discovery'] &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 2000 &&
             isValidStringList(data.tags, 10) &&
             (!('mediaDataUrl' in data) || (data.mediaDataUrl is string && data.mediaDataUrl.size() <= 350000)) &&
             (!('linkedUrl' in data) || isValidUrl(data.linkedUrl)) &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.savesCount is int && data.savesCount >= 0 &&
             data.sharesCount is int && data.sharesCount >= 0 &&
             data.moderationStatus in ['active', 'hidden', 'removed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPostComment(data) {
      return data.postId is string && data.postId.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorAvatarUrl' in data) || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500)) &&
             (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128)) &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.moderationStatus in ['active', 'removed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLikeRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.targetType in ['post', 'resource'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSavedItem(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.targetType in ['tool', 'resource', 'post'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 140)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFollowRecord(data) {
      return data.followerId is string && data.followerId.size() <= 128 &&
             data.followingId is string && data.followingId.size() <= 128 &&
             data.followerId != data.followingId &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNotificationItem(data) {
      return data.recipientId is string && data.recipientId.size() <= 128 &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
             data.type in ['like', 'comment', 'reply', 'follow', 'moderation'] &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.seen is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidModerationReport(data) {
      return data.reporterId is string && data.reporterId.size() <= 128 &&
             data.targetType in ['post', 'resource', 'user', 'comment'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 120 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             data.status in ['open', 'reviewed', 'resolved', 'dismissed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserBlock(data) {
      return data.blockerId is string && data.blockerId.size() <= 128 &&
             data.blockedUserId is string && data.blockedUserId.size() <= 128 &&
             data.blockerId != data.blockedUserId &&
             isValidTimestamp(data.createdAt);
    }

    function isValidEngagementEvent(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.targetType in ['tool', 'resource', 'post'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.eventType in ['tool_open', 'resource_view', 'save', 'like', 'comment', 'share'] &&
             data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.validEvent == true &&
             isValidTimestamp(data.createdAt);
    }

    // --- ADMINS (server-managed only) ---
    match /admins/{userId} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    // --- PRIVATE USER PII & PREFERENCES ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'active' &&
                       incoming().keys().hasAll(['userId', 'preferredLanguage', 'themeMode', 'aiModel', 'accountStatus', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'preferredLanguage', 'themeMode', 'aiModel', 'accountStatus', 'createdAt', 'updatedAt']) &&
                       isValidUserPrivate(incoming());
      allow update: if isValidId(userId) &&
                       isValidUserPrivate(incoming()) &&
                       (
                         (isOwner(userId) &&
                          incoming().userId == existing().userId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'preferredLanguage', 'themeMode', 'aiModel', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().userId == existing().userId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'updatedAt']))
                       );
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // --- PUBLIC CREATOR PROFILES (NO PII) ---
    match /public_profiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if existing().publicProfile == true;
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().followersCount == 0 &&
                       incoming().followingCount == 0 &&
                       incoming().postsCount == 0 &&
                       incoming().resourcesCount == 0 &&
                       incoming().keys().hasAll(['userId', 'displayName', 'username', 'publicProfile', 'followersCount', 'followingCount', 'postsCount', 'resourcesCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'username', 'bio', 'avatarUrl', 'specialty', 'publicProfile', 'followersCount', 'followingCount', 'postsCount', 'resourcesCount', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming());
      allow update: if isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Owner editing profile info
                         (isOwner(userId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'bio', 'avatarUrl', 'specialty', 'publicProfile', 'postsCount', 'resourcesCount', 'followingCount', 'updatedAt'])) ||
                         // Follower incrementing/decrementing target user's followersCount atomically with follow doc
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) &&
                          (incoming().followersCount == existing().followersCount + 1 || incoming().followersCount == existing().followersCount - 1))
                       );
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // --- CREATIVE TOOLS DIRECTORY ---
    match /tools/{toolId} {
      allow get: if isValidId(toolId) && (existing().verified == true || isAdmin());
      allow list: if existing().verified == true || isAdmin();
      allow create: if isValidId(toolId) && isAdmin() && isValidCreativeTool(incoming()) &&
                       incoming().keys().hasAll(['name', 'nameAr', 'description', 'descriptionAr', 'categories', 'officialUrl', 'pricing', 'platforms', 'ratingAvg', 'ratingCount', 'savesCount', 'verified', 'lastVerifiedDate', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'nameAr', 'description', 'descriptionAr', 'categories', 'officialUrl', 'pricing', 'platforms', 'ratingAvg', 'ratingCount', 'savesCount', 'verified', 'lastVerifiedDate', 'accentHex', 'createdAt', 'updatedAt']);
      allow update: if isValidId(toolId) && isValidCreativeTool(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['savesCount', 'updatedAt']) &&
                          (incoming().savesCount == existing().savesCount + 1 || incoming().savesCount == existing().savesCount - 1))
                       );
      allow delete: if isValidId(toolId) && isAdmin();
    }

    // --- CREATIVE RESOURCE LIBRARY ---
    match /resources/{resourceId} {
      allow get: if isValidId(resourceId) && (existing().moderationStatus == 'approved' || isOwner(existing().creatorId) || isAdmin());
      allow list: if existing().moderationStatus == 'approved' || (isSignedIn() && existing().creatorId == request.auth.uid) || isAdmin();
      allow create: if isValidId(resourceId) &&
                       isSignedIn() &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().savesCount == 0 &&
                       incoming().likesCount == 0 &&
                       incoming().moderationStatus in ['pending', 'approved'] &&
                       incoming().keys().hasAll(['creatorId', 'creatorName', 'title', 'titleAr', 'description', 'descriptionAr', 'category', 'tags', 'fileFormat', 'fileSizeLabel', 'licenseInfo', 'downloadUrl', 'savesCount', 'likesCount', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['creatorId', 'creatorName', 'title', 'titleAr', 'description', 'descriptionAr', 'category', 'tags', 'previewImageUrl', 'fileFormat', 'fileSizeLabel', 'licenseInfo', 'downloadUrl', 'savesCount', 'likesCount', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                       isValidCreativeResource(incoming());
      allow update: if isValidId(resourceId) &&
                       isValidCreativeResource(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (isOwner(existing().creatorId) &&
                          incoming().moderationStatus == existing().moderationStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'titleAr', 'description', 'descriptionAr', 'category', 'tags', 'previewImageUrl', 'fileFormat', 'fileSizeLabel', 'licenseInfo', 'downloadUrl', 'updatedAt'])) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['savesCount', 'updatedAt']) &&
                          (incoming().savesCount == existing().savesCount + 1 || incoming().savesCount == existing().savesCount - 1)) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                          (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1))
                       );
      allow delete: if isValidId(resourceId) && (isOwner(existing().creatorId) || isAdmin());
    }

    // --- COMMUNITY POSTS ---
    match /posts/{postId} {
      allow get: if isValidId(postId) && (existing().moderationStatus == 'active' || isOwner(existing().authorId) || isAdmin());
      allow list: if existing().moderationStatus == 'active' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
      allow create: if isValidId(postId) &&
                       isSignedIn() &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().savesCount == 0 &&
                       incoming().sharesCount == 0 &&
                       incoming().moderationStatus == 'active' &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'authorUsername', 'postType', 'category', 'title', 'description', 'tags', 'likesCount', 'commentsCount', 'savesCount', 'sharesCount', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorName', 'authorUsername', 'authorAvatarUrl', 'postType', 'category', 'title', 'description', 'tags', 'mediaDataUrl', 'linkedUrl', 'likesCount', 'commentsCount', 'savesCount', 'sharesCount', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                       isValidCommunityPost(incoming());
      allow update: if isValidId(postId) &&
                       isValidCommunityPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (isOwner(existing().authorId) &&
                          incoming().moderationStatus == existing().moderationStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'tags', 'linkedUrl', 'updatedAt'])) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                          (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
                          incoming().commentsCount == existing().commentsCount + 1) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['savesCount', 'updatedAt']) &&
                          (incoming().savesCount == existing().savesCount + 1 || incoming().savesCount == existing().savesCount - 1)) ||
                         (isSignedIn() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt']) &&
                          incoming().sharesCount == existing().sharesCount + 1)
                       );
      allow delete: if isValidId(postId) && (isOwner(existing().authorId) || isAdmin());

      // Nested post comments & replies
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) && (existing().moderationStatus == 'active' || isAdmin());
        allow list: if existing().moderationStatus == 'active' || isAdmin();
        allow create: if isValidId(postId) && isValidId(commentId) &&
                         isSignedIn() &&
                         incoming().authorId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().moderationStatus == 'active' &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         incoming().keys().hasAll(['postId', 'authorId', 'authorName', 'body', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['postId', 'authorId', 'authorName', 'authorAvatarUrl', 'parentCommentId', 'body', 'moderationStatus', 'createdAt', 'updatedAt']) &&
                         isValidPostComment(incoming());
        allow update: if isValidId(postId) && isValidId(commentId) &&
                         isValidPostComment(incoming()) &&
                         incoming().authorId == existing().authorId &&
                         incoming().postId == existing().postId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           isAdmin() ||
                           (isOwner(existing().authorId) &&
                            incoming().moderationStatus == existing().moderationStatus &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt']))
                         );
        allow delete: if isValidId(postId) && isValidId(commentId) && (isOwner(existing().authorId) || isAdmin());
      }
    }

    // --- LIKES ---
    match /likes/{likeId} {
      allow get: if isValidId(likeId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(likeId) &&
                       isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       likeId == request.auth.uid + '_' + incoming().targetType + '_' + incoming().targetId &&
                       incoming().keys().hasAll(['userId', 'targetType', 'targetId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'targetType', 'targetId', 'createdAt']) &&
                       isValidLikeRecord(incoming());
      allow delete: if isValidId(likeId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- SAVED ITEMS ---
    match /saved_items/{saveId} {
      allow get: if isValidId(saveId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(saveId) &&
                       isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       saveId == request.auth.uid + '_' + incoming().targetType + '_' + incoming().targetId &&
                       incoming().keys().hasAll(['userId', 'targetType', 'targetId', 'title', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'targetType', 'targetId', 'title', 'subtitle', 'createdAt']) &&
                       isValidSavedItem(incoming());
      allow delete: if isValidId(saveId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- FOLLOWS ---
    match /follows/{followId} {
      allow get: if isValidId(followId) && isSignedIn() &&
                    (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid);
      allow list: if isSignedIn() &&
                    (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid);
      allow create: if isValidId(followId) &&
                       isSignedIn() &&
                       incoming().followerId == request.auth.uid &&
                       followId == request.auth.uid + '_' + incoming().followingId &&
                       incoming().keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerId', 'followingId', 'createdAt']) &&
                       isValidFollowRecord(incoming());
      allow delete: if isValidId(followId) && isSignedIn() && existing().followerId == request.auth.uid;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && existing().recipientId == request.auth.uid;
      allow list: if isSignedIn() && existing().recipientId == request.auth.uid;
      allow create: if isValidId(notificationId) &&
                       isSignedIn() &&
                       incoming().actorId == request.auth.uid &&
                       incoming().seen == false &&
                       incoming().keys().hasAll(['recipientId', 'actorId', 'actorName', 'type', 'message', 'seen', 'createdAt']) &&
                       incoming().keys().hasOnly(['recipientId', 'actorId', 'actorName', 'type', 'targetId', 'message', 'seen', 'createdAt']) &&
                       isValidNotificationItem(incoming());
      allow update: if isValidId(notificationId) &&
                       isSignedIn() &&
                       existing().recipientId == request.auth.uid &&
                       isValidNotificationItem(incoming()) &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().actorId == existing().actorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['seen']);
      allow delete: if isValidId(notificationId) && isSignedIn() && existing().recipientId == request.auth.uid;
    }

    // --- MODERATION REPORTS ---
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId) &&
                       isSignedIn() &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
                       isValidModerationReport(incoming());
      allow update: if isValidId(reportId) &&
                       isAdmin() &&
                       isValidModerationReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // --- USER BLOCKS ---
    match /blocks/{blockId} {
      allow get: if isValidId(blockId) && isSignedIn() && existing().blockerId == request.auth.uid;
      allow list: if isSignedIn() && existing().blockerId == request.auth.uid;
      allow create: if isValidId(blockId) &&
                       isSignedIn() &&
                       incoming().blockerId == request.auth.uid &&
                       blockId == request.auth.uid + '_' + incoming().blockedUserId &&
                       incoming().keys().hasAll(['blockerId', 'blockedUserId', 'createdAt']) &&
                       incoming().keys().hasOnly(['blockerId', 'blockedUserId', 'createdAt']) &&
                       isValidUserBlock(incoming());
      allow delete: if isValidId(blockId) && isSignedIn() && existing().blockerId == request.auth.uid;
    }

    // --- DEDUPLICATED ENGAGEMENT EVENTS (ANTI-SPAM ANALYTICS) ---
    match /engagement_events/{eventId} {
      allow get: if isValidId(eventId) && existing().validEvent == true;
      allow list: if existing().validEvent == true;
      allow create: if isValidId(eventId) &&
                       isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       eventId == request.auth.uid + '_' + incoming().targetType + '_' + incoming().targetId + '_' + incoming().eventType + '_' + incoming().dayKey &&
                       incoming().keys().hasAll(['userId', 'targetType', 'targetId', 'eventType', 'dayKey', 'validEvent', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'targetType', 'targetId', 'eventType', 'dayKey', 'validEvent', 'createdAt']) &&
                       isValidEngagementEvent(incoming());
      allow update, delete: if false;
    }
  }
}
